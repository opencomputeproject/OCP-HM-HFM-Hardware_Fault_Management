@startuml

title AI Node Example - Full Structure with Attributes

' Node
class Node {
    nodeId : NODE-AI-001
    nodeType : AI Server
    hostname : ai-node-01
    networkConfiguration : { ipAddresses[], ports[], macAddresses[] }
    physicalLocation : { rack, row, datacenter, placement }
}

' Assemblies
class Baseboard {
    assemblyId : ASM-BASE-001
    assemblyName : Baseboard
    manufacturerSerialNumber : SN-BASE-123456
    physicalLocation : { slot, Position }
    logicalAssociation : { links[] }
}

class UBB {
    assemblyId : UBB-01
    assemblyName : UBB
    manufacturerSerialNumber : SN-UBB-111
    physicalLocation : { slot, Position }
}

class OAM_01 {
    assemblyId : OAM-01
    assemblyName : OAM-01
    manufacturerSerialNumber : SN-OAM-111
}

class OAM_02 {
    assemblyId : OAM-02
    assemblyName : OAM-02
    manufacturerSerialNumber : SN-OAM-222
}

' Components with full attributes
class CPU_01 {
    componentType : CPU
    componentId : CPU-01
    manufacturerSerialNumber : SN-CPU-111
    physicalLocation : { slot, Position }
    logicalAssociation : { links[] }
    firmware : [version, lastUpdated, SVN, minSVN, imageRole]
    configuration : [name, value, description]
}

class CPU_02 {
    componentType : CPU
    componentId : CPU-02
    manufacturerSerialNumber : SN-CPU-222
    physicalLocation : { slot, Position }
    logicalAssociation : { links[] }
    firmware : [version, lastUpdated, SVN, minSVN, imageRole]
    configuration : [name, value, description]
}

class MEM_01 {
    componentType : Memory
    componentId : MEM-01
    manufacturerSerialNumber : SN-MEM-111
    physicalLocation : { slot, Position }
