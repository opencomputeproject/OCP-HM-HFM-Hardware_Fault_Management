' Relationships
Node --> Baseboard : contains
Baseboard --> CPU_01
Baseboard --> CPU_02
Baseboard --> MEM_01
Baseboard --> MEM_02
Baseboard --> BMC_Base
Baseboard --> NVME_01
Baseboard --> NVME_02
Baseboard --> NIC_01
Baseboard --> NIC_02
Baseboard --> UBB : subAssembly

UBB --> BMC_UBB
UBB --> OAM_01 : subAssembly
UBB --> OAM_02 : subAssembly

OAM_01 --> GPU_01
OAM_01 --> AMC_01
OAM_02 --> GPU_02
OAM_02 --> AMC_02

@enduml
