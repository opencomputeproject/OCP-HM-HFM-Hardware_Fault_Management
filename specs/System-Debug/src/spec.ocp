  "NodeId": "AI-Node-001",
  "NodeType": "AI Server",
  "Hostname": "ai-node-001.dc.local",
  "NetworkConfiguration": {
    "IpAddresses": ["192.168.10.101"],
    "Ports": [22, 443],
    "MacAddresses": ["00:1A:2B:3C:4D:5E"]
